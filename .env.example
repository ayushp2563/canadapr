# ===================================
# Canada Immigration Assistant - ENV
# ===================================

# --- LLM APIs ---
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
# Optional: Used as embedding fallback if Groq embeddings unavailable
OPENAI_API_KEY=your_openai_api_key_here

# --- Database ---
DATABASE_URL=postgresql://canadapr:canadapr_pass@localhost:5432/canada_immigration

# --- Vector Store ---
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=ircc_documents

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Scraper ---
SCRAPER_INTERVAL_HOURS=6

# --- Security ---
WEBHOOK_API_KEY=your-secret-webhook-key-here

# --- Optional Integrations ---
# Slack or Discord webhook for new Express Entry draw alerts
ALERT_WEBHOOK_URL=

# --- Frontend (set in src/ui/.env) ---
# VITE_API_URL=http://localhost:3001

{
  "name": "canada-immigration-assistant",
  "version": "1.0.0",
  "description": "Canada Permanent Pathways AI Immigration Assistant powered by Groq LLM",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc",
    "start": "node dist/api/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "scrape:once": "tsx src/scraper/irccScraper.ts",
    "draws:check": "tsx src/scraper/drawTracker.ts",
    "embed:all": "tsx src/rag/embeddings.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/community": "^0.3.0",
    "@langchain/core": "^0.3.0",
    "@mistralai/mistralai": "^1.3.0",
    "@prisma/client": "^5.22.0",
    "cheerio": "^1.0.0",
    "chromadb": "^1.9.2",
    "cors": "^8.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "groq-sdk": "^0.7.0",
    "helmet": "^8.0.0",
    "htmlparser2": "^12.0.0",
    "langchain": "^0.3.0",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "playwright": "^1.48.2",
    "rss-parser": "^3.13.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
